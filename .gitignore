.claude/settings.local.json
# Persistent per-session memory (local only, never versioned).
.claude/projects/
__pycache__/
.pytest_cache/
# Packaging metadata regenerated by every editable install.
*.egg-info/
.venv
uv.lock
# Persisted defs left on disk by examples/persistent_graphdef.py (explore, then rm -rf)
/examples/defs_store
# Where scripts/render-all.sh drops its WAVs by default (a bench, not a fixture)
/render
# Personal scratch files (nombre.notrack.md): never committed.
*.notrack.md
# Working design notes and implementation plans (local only). What shipped is
# the git history and the PLAN.md roadmaps; a spec is scaffolding, not a record.
/specs/
# Subagent-driven-development scratch (ledgers, briefs, review packages).
/.superpowers/
# The web client staged into the Jupyter package (built, not authored).
/clients/jupyter/clausters_jupyter/_web/
/clients/jupyter/clausters_jupyter/static/
# What a Jupyter session leaves in the working tree while the notebook
# package is tested from here: a scratch notebook and its checkpoints.
/Untitled*.ipynb
.ipynb_checkpoints/
# The notebook examples are authored as `# %%` files, like every other example
# in this project, and jupytext pairs each with an .ipynb so JupyterLab can
# open it (see clients/jupyter/examples/jupytext.toml). The notebook is the
# generated half -- regenerate it with `jupytext --sync`, do not commit it.
/clients/jupyter/examples/*.ipynb
