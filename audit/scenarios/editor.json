{
  "format_version": 1,
  "id": "editor",
  "unit": "editor",
  "status": "ready",
  "scope": "clausters-editor (crates/clausters-editor) is the code editor: a crate of the workspace linking the GUI host, its page (an npm package of its own) and its Python wheel. Do not infer its quality from the audio project.",
  "acceptance": "The page's typecheck and build, the crate's fmt/clippy/tests, the session driver's tests, plus UI/session, packaging and third-party license review.",
  "steps": [
    {
      "id": "editor-page-build",
      "kind": "command",
      "required": true,
      "argv": [
        "./build.sh",
        "debug"
      ],
      "cwd": "crates/clausters-editor/page",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 1800,
      "depends_on": [],
      "profile": "debug"
    },
    {
      "id": "editor-page-check",
      "kind": "command",
      "required": true,
      "argv": [
        "npm",
        "run",
        "check"
      ],
      "cwd": "crates/clausters-editor/page",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 1800,
      "depends_on": [
        "editor-page-build"
      ],
      "profile": "debug"
    },
    {
      "id": "editor-fmt",
      "kind": "command",
      "required": true,
      "argv": [
        "cargo",
        "fmt",
        "--check",
        "-p",
        "clausters-editor"
      ],
      "cwd": ".",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 1800,
      "depends_on": [],
      "profile": "debug"
    },
    {
      "id": "editor-clippy",
      "kind": "command",
      "required": true,
      "argv": [
        "cargo",
        "clippy",
        "--message-format=json",
        "--locked",
        "--offline",
        "-p",
        "clausters-editor",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "cwd": ".",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [],
      "profile": "debug"
    },
    {
      "id": "editor-tests",
      "kind": "command",
      "required": true,
      "argv": [
        "cargo",
        "test",
        "--message-format=json",
        "--locked",
        "--offline",
        "-p",
        "clausters-editor"
      ],
      "cwd": ".",
      "parser": "rust-tests",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [],
      "profile": "debug"
    },
    {
      "id": "editor-driver",
      "kind": "command",
      "required": true,
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "crates/clausters-editor/python",
        "-p",
        "test_*.py"
      ],
      "cwd": ".",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 1800,
      "depends_on": [],
      "profile": "debug"
    },
    {
      "id": "editor-review",
      "kind": "manual",
      "required": true,
      "instructions": "Follow procedures/editor.md. Include the editor's crate, page and wheel manifests in coverage, UI/session/recovery, the Python package and `node scripts/notices.mjs --check` with cargo-about 0.9.2. Retain separate performance and license evidence.",
      "depends_on": []
    }
  ]
}
