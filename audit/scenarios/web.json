{
  "format_version": 1,
  "id": "web",
  "unit": "web",
  "status": "ready",
  "scope": "TypeScript client and its node/browser runtime, audited separately with clausters-python as API/behavior reference.",
  "acceptance": "Build precedes test; node/browser suite must execute and hidden skips prevent acceptance. Explicit API/example parity and browser performance review required.",
  "steps": [
    {
      "id": "web-assets",
      "kind": "command",
      "required": true,
      "argv": [
        "{python}",
        "{audit}/scripts/audit.py",
        "preflight-web",
        "--source",
        "{source}"
      ],
      "cwd": ".",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 30,
      "depends_on": []
    },
    {
      "id": "web-native-server",
      "kind": "command",
      "required": true,
      "argv": [
        "cargo",
        "build",
        "--message-format=json",
        "--locked",
        "--offline"
      ],
      "cwd": ".",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [
        "web-assets"
      ],
      "profile": "debug"
    },
    {
      "id": "web-native-gui",
      "kind": "command",
      "required": true,
      "argv": [
        "cargo",
        "build",
        "--message-format=json",
        "--locked",
        "--offline",
        "--bin",
        "clausters-gui"
      ],
      "cwd": "clients/gui",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [
        "web-assets"
      ],
      "profile": "debug"
    },
    {
      "id": "web-build",
      "kind": "command",
      "required": true,
      "argv": [
        "bash",
        "./build.sh"
      ],
      "cwd": "clients/web",
      "parser": "exit",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [
        "web-assets"
      ],
      "profile": "debug",
      "preflight": "web",
      "generated_outputs": [
        "clients/web/src/core/clausters_core_web.d.ts",
        "clients/web/src/engine/clausters_web.d.ts",
        "clients/web/src/gui-host/clausters_gui.d.ts",
        "clients/web/src/nrt/clausters_nrt_web.d.ts"
      ]
    },
    {
      "id": "web-tests",
      "kind": "command",
      "required": true,
      "argv": [
        "bash",
        "./test.sh"
      ],
      "cwd": "clients/web",
      "parser": "node-tests",
      "repetitions": 1,
      "warmup": 0,
      "timeout_seconds": 3600,
      "depends_on": [
        "web-native-server",
        "web-native-gui",
        "web-build"
      ],
      "profile": "debug"
    },
    {
      "id": "web-review",
      "kind": "manual",
      "required": true,
      "instructions": "Follow procedures/clients.md. Compare API and example calls side by side against the Python reference, check binding vectors, Worker/OPFS paths, scheduling and browser timing/allocations. Retain browser/version/flags and unsupported cases.",
      "depends_on": []
    }
  ]
}
