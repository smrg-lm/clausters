# The emitted package (tsc: js + d.ts + maps) with the staged wasm bundles
# (build.sh copies them from crates/clausters-web, clients/gui and
# crates/clausters-core-web) — the browser's _bin/_libs.
/dist/
# The vendored engraver and the vendored Faust compiler: build products of
# third_party/build-verovio-wasm.sh and third_party/build-faust-wasm.sh,
# several megabytes of wasm each. Staged into dist/ by build.sh, never
# committed.
/vendor/
node_modules/

# Glue stubs staged into src/ by build.sh (type-checking + node-from-source).
# The three declaration files are the exception: they are what TypeDoc needs to
# resolve the wasm boundary, and the book is built where no Rust toolchain
# exists (Read the Docs). Keeping them versioned makes a change to the Rust
# API visible as a diff after build.sh, instead of only as a doc build that
# fails somewhere else.
/src/core/*
!/src/core/clausters_core_web.d.ts
/src/gui-host/*
!/src/gui-host/clausters_gui.d.ts
/src/engine/clausters_web.js

# What the examples' generators write: the bundles the make_bundle.mjs scripts
# author, the raw one standalone.mjs writes, and the demo bundle the smokes use
# (tools/demo-bundle.sh). One directory per example tree, so a run leaves one
# place to look in and one to delete.
/examples/out/

# Fixtures the parity/bulk harnesses generate next to the test pages.
/tests/score.bin
/tests/native.f32
/tests/score-faust.bin
/tests/native-faust.f32
/tests/sine.f32
/tests/sine.peaks

# Self-signed certificate for serving over HTTPS on the LAN — AudioWorklet and
# WebGPU need a secure context, which a plain-HTTP LAN address is not, so
# testing on a phone means https. Never commit the private key.
/.certs/

# The documentation book: the API pages TypeDoc generates and mdBook's output.
/docs/src/api/
/docs/book/
