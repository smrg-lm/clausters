{
  "name": "clausters",
  "version": "0.8.1",
  "description": "Clausters in the browser: the audio engine in an AudioWorklet, the GUI host on a canvas, web components that boot standalone bundles, and the OSC/connection seam of the TypeScript client — no server process needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./defs": {
      "types": "./dist/defs/index.d.ts",
      "default": "./dist/defs/index.js"
    },
    "./seq": {
      "types": "./dist/seq/index.d.ts",
      "default": "./dist/seq/index.js"
    },
    "./gui": {
      "types": "./dist/gui/index.d.ts",
      "default": "./dist/gui/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "COPYING"
  ],
  "scripts": {
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 'tests/*.test.ts'",
    "docs": "docs/build.sh",
    "check-package": "node tools/check-package.mjs",
    "prepublishOnly": "node tools/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7"
  },
  "keywords": [
    "audio",
    "synthesis",
    "dsp",
    "osc",
    "supercollider",
    "faust",
    "webassembly",
    "audioworklet",
    "webgpu"
  ],
  "homepage": "https://github.com/smrg-lm/clausters/tree/main/clients/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smrg-lm/clausters.git",
    "directory": "clients/web"
  },
  "bugs": "https://github.com/smrg-lm/clausters/issues",
  "author": "Lucas Samaruga",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "GPL-3.0-or-later"
}
