{
  "name": "clausters",
  "version": "0.3.0",
  "description": "Clausters in the browser: the audio engine in an AudioWorklet, the GUI host on a canvas, web components that boot standalone bundles, and the OSC/connection seam of the TypeScript client — no server process needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "COPYING"
  ],
  "scripts": {
    "check": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 'tests/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7"
  },
  "license": "GPL-3.0-or-later"
}
