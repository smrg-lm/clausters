{
  "name": "clausters",
  "version": "0.11.0",
  "description": "Clausters in the browser: the audio engine in an AudioWorklet, the GUI host on a canvas, web components that boot standalone bundles, and the OSC/connection seam of the TypeScript client -- no server process needed.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base/index.d.ts",
      "default": "./dist/base/index.js"
    },
    "./base/builtins": {
      "types": "./dist/base/builtins.d.ts",
      "default": "./dist/base/builtins.js"
    },
    "./bundle": {
      "types": "./dist/bundle-writer.d.ts",
      "default": "./dist/bundle-writer.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./defs": {
      "types": "./dist/defs/index.d.ts",
      "default": "./dist/defs/index.js"
    },
    "./defs/pv_expr": {
      "types": "./dist/defs/pv_expr.d.ts",
      "default": "./dist/defs/pv_expr.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./gui": {
      "types": "./dist/gui/index.d.ts",
      "default": "./dist/gui/index.js"
    },
    "./gui/guidef": {
      "types": "./dist/gui/guidef.d.ts",
      "default": "./dist/gui/guidef.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./multitrack": {
      "types": "./dist/multitrack.d.ts",
      "default": "./dist/multitrack.js"
    },
    "./panic": {
      "types": "./dist/panic.d.ts",
      "default": "./dist/panic.js"
    },
    "./play": {
      "types": "./dist/play.d.ts",
      "default": "./dist/play.js"
    },
    "./plot": {
      "types": "./dist/plot.d.ts",
      "default": "./dist/plot.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./responders": {
      "types": "./dist/responders.d.ts",
      "default": "./dist/responders.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./scope": {
      "types": "./dist/scope.d.ts",
      "default": "./dist/scope.js"
    },
    "./segments": {
      "types": "./dist/segments.d.ts",
      "default": "./dist/segments.js"
    },
    "./seq": {
      "types": "./dist/seq/index.d.ts",
      "default": "./dist/seq/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./soundfile": {
      "types": "./dist/soundfile.d.ts",
      "default": "./dist/soundfile.js"
    }
  },
  "clausters-editor": {
    "interrupt": "./dist/editor.js#interrupt",
    "docs": {
      "clausters": "./dist/books/client",
      "clausters-server": "./dist/books/server"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "COPYING"
  ],
  "scripts": {
    "check": "tsc",
    "lint": "biome lint --error-on-warnings .",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-concurrency=1 'tests/*.test.ts'",
    "docs": "docs/build.sh",
    "check-package": "node tools/check-package.mjs",
    "prepublishOnly": "node tools/check-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^24",
    "esbuild": "^0.28.1",
    "typescript": "^7"
  },
  "keywords": [
    "audio",
    "synthesis",
    "dsp",
    "osc",
    "supercollider",
    "faust",
    "webassembly",
    "audioworklet",
    "webgpu"
  ],
  "homepage": "https://github.com/smrg-lm/clausters/tree/main/clients/web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smrg-lm/clausters.git",
    "directory": "clients/web"
  },
  "bugs": "https://github.com/smrg-lm/clausters/issues",
  "author": "Lucas Samaruga",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "GPL-3.0-or-later"
}
