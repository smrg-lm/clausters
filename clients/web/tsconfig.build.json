{
    // The emit config (`npm run build`): src/ -> dist/, each module at the
    // same relative path, with declarations and source/declaration maps (the
    // browser interface is JS-with-a-type-map). Tests are excluded — they
    // run from source under node; tsconfig.json type-checks them.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src/**/*.ts"]
}
