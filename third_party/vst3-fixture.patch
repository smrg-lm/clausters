+impl IPlugViewTrait for View {
+    unsafe fn isPlatformTypeSupported(&self, kind: FIDString) -> tresult {
+        if std::ffi::CStr::from_ptr(kind).to_bytes() == b"X11EmbedWindowID" {
+            kResultOk
+        } else {
+            kResultFalse
+        }
+    }
+    unsafe fn attached(&self, parent: *mut c_void, kind: FIDString) -> tresult {
+        assert_eq!(self.main, std::thread::current().id());
+        if parent.is_null() || self.isPlatformTypeSupported(kind) != kResultOk {
+            return kInvalidArgument;
+        }
+        let frame = self.frame.borrow().as_ref().unwrap().clone();
+        let run_loop = frame
+            .cast::<IRunLoop>()
+            .expect("Linux frame must expose its run loop");
+        let display = XOpenDisplay(ptr::null());
+        if display.is_null() {
+            return kResultFalse;
+        }
+        let child = XCreateSimpleWindow(display, parent as u64, 0, 0, 320, 200, 0, 0, 0x442266);
+        let mut fd = [-1; 2];
+        assert_eq!(pipe(fd.as_mut_ptr()), 0);
+        let callback = ComWrapper::new(EditorCallback {
+            main: self.main,
+            handler: self.handler.clone(),
+            display,
+            child,
+            fd,
+            ticked: Cell::new(false),
+            readable: Cell::new(false),
+        });
+        assert_eq!(
+            run_loop.registerTimer(callback.to_com_ptr::<ITimerHandler>().unwrap().as_ptr(), 20),
+            kResultOk
+        );
+        assert_eq!(
+            run_loop.registerEventHandler(
+                callback.to_com_ptr::<IEventHandler>().unwrap().as_ptr(),
+                fd[0]
+            ),
+            kResultOk
+        );
+        assert_eq!(write(fd[1], b"x".as_ptr().cast(), 1), 1);
+        XMapWindow(display, child);
+        XFlush(display);
+        *self.callback.borrow_mut() = Some(callback);
+        self.parent.set(parent as u64);
+        kResultOk
+    }
+    unsafe fn removed(&self) -> tresult {
+        assert_eq!(self.main, std::thread::current().id());
+        if let Some(callback) = self.callback.borrow_mut().take() {
+            let frame = self.frame.borrow().as_ref().unwrap().clone();
+            let run_loop = frame.cast::<IRunLoop>().unwrap();
+            assert_eq!(
+                run_loop.unregisterTimer(callback.to_com_ptr::<ITimerHandler>().unwrap().as_ptr()),
+                kResultOk
+            );
+            assert_eq!(
+                run_loop.unregisterEventHandler(
+                    callback.to_com_ptr::<IEventHandler>().unwrap().as_ptr()
+                ),
+                kResultOk
+            );
+        }
+        self.parent.set(0);
+        kResultOk
+    }
+    unsafe fn onWheel(&self, _: f32) -> tresult {
+        kResultOk
+    }
+    unsafe fn onKeyDown(&self, _: char16, _: int16, _: int16) -> tresult {
+        kResultOk
+    }
+    unsafe fn onKeyUp(&self, _: char16, _: int16, _: int16) -> tresult {
+        kResultOk
+    }
+    unsafe fn getSize(&self, size: *mut ViewRect) -> tresult {
+        let (width, height) = self.size.get();
+        *size = ViewRect {
+            left: 0,
+            top: 0,
+            right: width,
+            bottom: height,
+        };
+        kResultOk
+    }
+    unsafe fn onSize(&self, size: *mut ViewRect) -> tresult {
+        assert_eq!(self.main, std::thread::current().id());
+        let (w, h) = ((*size).right - (*size).left, (*size).bottom - (*size).top);
+        self.size.set((w, h));
+        if let Some(c) = self.callback.borrow().as_ref() {
+            XResizeWindow(c.display, c.child, w as u32, h as u32);
+            XFlush(c.display);
+        }
+        kResultOk
+    }
+    unsafe fn onFocus(&self, _: TBool) -> tresult {
+        kResultOk
+    }
+    unsafe fn setFrame(&self, frame: *mut IPlugFrame) -> tresult {
+        *self.frame.borrow_mut() = ComRef::from_raw(frame).map(|h| h.to_com_ptr());
+        kResultOk
+    }
+    unsafe fn canResize(&self) -> tresult {
+        kResultOk
+    }
+    unsafe fn checkSizeConstraint(&self, rect: *mut ViewRect) -> tresult {
+        if (*rect).right < 100 || (*rect).bottom < 100 {
+            return kInvalidArgument;
+        }
+        kResultOk
+    }
+}
