+impl IConnectionPointTrait for GainController {
+    unsafe fn connect(&self, other: *mut IConnectionPoint) -> tresult {
+        *self.connection.borrow_mut() = Some(ComRef::from_raw(other).unwrap().to_com_ptr());
+        kResultOk
+    }
+    unsafe fn disconnect(&self, _: *mut IConnectionPoint) -> tresult {
+        self.connection.borrow_mut().take();
+        kResultOk
+    }
+    unsafe fn notify(&self, message: *mut IMessage) -> tresult {
+        assert_eq!(self.main, std::thread::current().id());
+        let message = ComRef::from_raw(message).unwrap();
+        assert_eq!(
+            std::ffi::CStr::from_ptr(message.getMessageID()).to_bytes(),
+            b"fixture-connect"
+        );
+        let attrs = ComRef::from_raw(message.getAttributes()).unwrap();
+        let mut id = 0;
+        assert_eq!(attrs.getInt(c"identity".as_ptr(), &mut id), kResultOk);
+        assert_eq!(id, 19);
+        kResultOk
+    }
+}
+impl IMidiMappingTrait for GainController {
+    unsafe fn getMidiControllerAssignment(
+        &self,
+        bus: i32,
+        channel: i16,
+        cc: i16,
+        id: *mut u32,
+    ) -> tresult {
+        assert_eq!(self.main, std::thread::current().id());
+        if bus == 0 && channel == 2 && cc == 7 {
+            *id = 0;
+            kResultOk
+        } else {
+            kResultFalse
+        }
+    }
+}
