+// The editor exercises both Linux run-loop interfaces on the helper main thread.
+use vst3::Steinberg::Linux::*;
+#[link(name = "X11")]
+extern "C" {
+    fn XOpenDisplay(name: *const c_char) -> *mut c_void;
+    fn XCloseDisplay(display: *mut c_void) -> i32;
+    fn XCreateSimpleWindow(
+        display: *mut c_void,
+        parent: u64,
+        x: i32,
+        y: i32,
+        w: u32,
+        h: u32,
+        border: u32,
+        foreground: u64,
+        background: u64,
+    ) -> u64;
+    fn XMapWindow(display: *mut c_void, window: u64) -> i32;
+    fn XResizeWindow(display: *mut c_void, window: u64, width: u32, height: u32) -> i32;
+    fn XDestroyWindow(display: *mut c_void, window: u64) -> i32;
+    fn XFlush(display: *mut c_void) -> i32;
+    fn XCreateGC(display: *mut c_void, window: u64, mask: u64, values: *mut c_void) -> *mut c_void;
+    fn XSetForeground(display: *mut c_void, gc: *mut c_void, color: u64) -> i32;
+    fn XDrawString(
+        display: *mut c_void,
+        window: u64,
+        gc: *mut c_void,
+        x: i32,
+        y: i32,
+        text: *const c_char,
+        count: i32,
+    ) -> i32;
+    fn XFreeGC(display: *mut c_void, gc: *mut c_void) -> i32;
+}
+extern "C" {
+    fn pipe(fds: *mut i32) -> i32;
+    fn read(fd: i32, buffer: *mut c_void, size: usize) -> isize;
+    fn write(fd: i32, buffer: *const c_void, size: usize) -> isize;
+    fn close(fd: i32) -> i32;
+}
+struct EditorCallback {
+    main: std::thread::ThreadId,
+    handler: Option<vst3::ComPtr<IComponentHandler>>,
+    display: *mut c_void,
+    child: u64,
+    fd: [i32; 2],
+    ticked: Cell<bool>,
+    readable: Cell<bool>,
+}
+impl Class for EditorCallback {
+    type Interfaces = (ITimerHandler, IEventHandler);
+}
+impl ITimerHandlerTrait for EditorCallback {
+    unsafe fn onTimer(&self) {
+        assert_eq!(self.main, std::thread::current().id());
+        if self.readable.get() && !self.ticked.replace(true) {
+            if let Some(h) = &self.handler {
+                assert_eq!(h.beginEdit(0), kResultOk);
+                assert_eq!(h.performEdit(0, 0.75), kResultOk);
+                assert_eq!(h.endEdit(0), kResultOk);
+            }
+        }
+        let gc = XCreateGC(self.display, self.child, 0, ptr::null_mut());
+        XSetForeground(self.display, gc, 0xffffff);
+        let text = b"Clausters VST3 fixture - gain 0.75";
+        XDrawString(
+            self.display,
+            self.child,
+            gc,
+            12,
+            30,
+            text.as_ptr().cast(),
+            text.len() as i32,
+        );
+        XFreeGC(self.display, gc);
+        XFlush(self.display);
+    }
+}
+impl IEventHandlerTrait for EditorCallback {
+    unsafe fn onFDIsSet(&self, fd: i32) {
+        assert_eq!(self.main, std::thread::current().id());
+        assert_eq!(fd, self.fd[0]);
+        let mut byte = 0u8;
+        assert_eq!(read(fd, (&mut byte as *mut u8).cast(), 1), 1);
+        self.readable.set(true);
+    }
+}
+impl Drop for EditorCallback {
+    fn drop(&mut self) {
+        unsafe {
+            close(self.fd[0]);
+            close(self.fd[1]);
+            XDestroyWindow(self.display, self.child);
+            XCloseDisplay(self.display);
+        }
+    }
+}
