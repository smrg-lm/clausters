     return out;
 }
 
+// -- clausters: the same shape as createDSPFactory above, over the Box and
+// Signal entry points. Everything after the factory call is identical, so it
+// is one helper.
+static FaustWasm wrapFactory(wasm_dsp_factory* factory)
+{
+    FaustWasm out;
+    if (factory) {
+        out.cfactory = int(factory);
+        string code = factory->getBinaryCode();
+        for (size_t i = 0; i < code.size(); i++) {
+            out.data.push_back(code[i]);
+        }
+        stringstream json;
+        factory->writeHelper(&json, false, false);
+        out.json = json.str();
+    }
+    return out;
+}
+
+FaustWasm libFaustWasm::createDSPFactoryFromBoxes(const string name, int box,
+                                                  const string args_aux, bool internal_memory)
+{
+    vector<string> argsv;
+    string2StringsVector(args_aux, argsv);
+    size_t       n = argsv.size();
+    string       error_msg;
+    const char** args = stringVector2argv(argsv);
+    wasm_dsp_factory* factory = ::createWasmDSPFactoryFromBoxes(
+        name, (Tree)(void*)box, n, args, error_msg, internal_memory);
+    delete[] args;
+    return wrapFactory(factory);
+}
+
+FaustWasm libFaustWasm::createDSPFactoryFromSignals(const string name, int signals, int count,
+                                                    const string args_aux, bool internal_memory)
+{
+    vector<string> argsv;
+    string2StringsVector(args_aux, argsv);
+    size_t       n = argsv.size();
+    string       error_msg;
+    const char** args = stringVector2argv(argsv);
+    tvec         outputs;
+    int*         handles = (int*)(void*)signals;
+    for (int i = 0; i < count; i++) {
+        outputs.push_back((Tree)(void*)handles[i]);
+    }
+    wasm_dsp_factory* factory =
+        ::createWasmDSPFactoryFromSignals(name, outputs, n, args, error_msg, internal_memory);
+    delete[] args;
+    return wrapFactory(factory);
+}
+
 void libFaustWasm::deleteDSPFactory(int cfactory)
 {
     deleteWasmDSPFactory(static_cast<wasm_dsp_factory*>((void*)cfactory));
