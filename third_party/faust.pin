# Pinned Faust toolchain for the vendored, reproducible build.
#
# Single source of truth for `third_party/build-faust.sh` (and, in a later
# phase, the CI composite and the release build). Shell-sourceable: KEY=VALUE,
# no spaces, no quoting needed.

# Where the pinned commit is fetched from. Our fork, because the pin below
# carries one patch that is not upstream yet (see FAUST_SHA). Point this back
# at https://github.com/grame-cncm/faust once the patch lands there.
FAUST_ORIGIN=https://github.com/smrg-lm/faust

# The commit the bundled libfaust is built from: the master-dev base "Set
# version to 2.86.0" (56c9e678d) plus exactly ONE patch, on the fork's
# fix-jit-target-order branch -- "Set the JIT target before initJIT(), not
# after". Without it `setTarget()` runs after the JIT has already compiled, so
# the target argument is silently ignored and every factory comes out
# host-tuned; that is what made CLAUSTERS_FAUST_TARGET a no-op and let CI
# runners SIGILL on JIT code their VM could not run (see docs/decisions.md).
#
# Still deliberately WITHOUT the boxcos/boxfmod fix -- the clone may carry a
# local fix-boxcos-boxfmod branch for development, but the shipped artifact
# stays off it so the upstream-bug canaries in tests/faust_box.rs and
# tests/faust_signal.rs remain valid. Full 40-char SHA: fetching an arbitrary
# commit by SHA only resolves unabbreviated.
FAUST_SHA=9f685488554b77323374f1fa7d492c3626e6e83b

# The LLVM the shipped libLLVM is built against. Pinned to 18: it is Ubuntu
# 24.04's default (so CI installs it from the distro repos, no apt.llvm.org),
# and the distro build targets a baseline x86-64, which keeps the bundled
# libLLVM portable -- it runs on any x86-64 machine, where a higher-baseline
# upstream build could hit an illegal instruction on older CPUs. The build
# drives it through `llvm-config-<version>`; a developer on a different LLVM
# (e.g. 21) overrides it with LLVM_CONFIG=llvm-config-21 -- the hand-written
# FFI surface is version-independent, only the shipped artifact is pinned.
FAUST_LLVM_VERSION=18
