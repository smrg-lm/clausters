#!/usr/bin/env bash
# No commit touching Rust without fmt + clippy clean, and none touching a book's
# sources without that book building.
#
# CLAUDE.md's commit workflow: "Before generating any commit that touches Rust,
# run `cargo fmt` ... the tree must be `cargo fmt --check`-clean" and "Clippy
# must come back clean, always -- zero warnings, not 'no new ones'".
#
# This does NOT enforce that rule, and cannot. A client-side git hook is skipped
# by `--no-verify`, by unsetting core.hooksPath, or by editing this file -- it
# sits in the working tree of the person it is checking. What it buys is
# *speed*: the same failure in two seconds, here, instead of five minutes into a
# CI run. CI (.github/workflows/ci.yml) is what actually enforces the rule,
# because the person committing cannot skip it.
#
# A *git* hook rather than an editor's or an agent's: git is the one thing that
# knows, with certainty, that a commit is happening. Anything upstream of it has
# to guess from the text of a command line -- and a guess that is wrong in the
# permissive direction is a gate that silently is not there. It also covers
# every commit, from any terminal, editor or script, not just the ones typed
# through one tool.
#
# Enable it once per clone (it lives in the repo, so it is versioned policy
# rather than a local preference):
#
#     git config core.hooksPath .githooks
#
# Only the workspaces the working tree actually touches are linted (root,
# clients/gui, fuzz -- three separate workspaces), and only the books whose
# sources it touches are built, so a commit pays for what it changed and
# nothing else.
#
# The books are here for the same reason as clippy, and are the check with the
# least local coverage of all: a dangling TSDoc `{@link}`, a page missing from a
# SUMMARY.md or a docstring pydoc-markdown chokes on compiles fine, tests fine,
# and is seen by nothing until CI's `docs` job -- which is where nearly every
# red build has come from. scripts/check-docs.sh runs the same three builds CI
# does, in about five seconds.
#
# The def-family matrix is NOT run here (five more builds); when the diff
# touches feature-gated code the hook points at the feature-matrix skill
# instead, pass or fail.
#
# Deliberately *not* a per-edit check: clippy is a compile, not a reformat. Per
# edit it would cost tens of seconds each time and fail constantly on
# half-finished refactors, which is how a hook gets turned off. Once per commit
# is rare, and it is the moment the rule exists for.
#
# Escape hatch: git commit --no-verify. Git's own, and unavoidable -- git skips
# the hook without running it, so nothing here could refuse. That is the honest
# shape of a client-side hook, and the reason the real gate is CI.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"

# Fail open, but say so. A machine that cannot run the check is not a reason to
# stop the work -- it is a reason to say the check is not running.
#
# The rustup *components* are checked alongside cargo itself, and matter more:
# a toolchain without clippy is far commoner than no cargo at all, and without
# the check `cargo clippy` would exit non-zero on "no such command", which this
# hook cannot tell from a warning -- it would block the commit on a diagnosis
# that is simply wrong, with a message about warnings that do not exist.
# cargo is usually missing because ~/.cargo/bin is on an interactive PATH but
# not on the non-interactive one hooks run under.
#
# The components are probed by *running* them, not by looking for a binary on
# the PATH: rustup puts a `cargo-clippy` proxy in ~/.cargo/bin whether or not
# the component is installed in the active toolchain, and cargo resolves its
# subcommands out of the toolchain directory anyway -- so `command -v` answers
# neither question. `--version` is a process spawn and no build.
# The verdict is deferred rather than acted on here: a missing toolchain must
# not silence the *book* legs below, which need none of it.
missing=""
if ! command -v cargo >/dev/null 2>&1; then
    missing=" cargo"
else
    cargo fmt --version >/dev/null 2>&1 || missing="$missing rustfmt"
    cargo clippy --version >/dev/null 2>&1 || missing="$missing clippy"
fi

# --- Which workspaces does the working tree touch? ---------------------------
#
# The *working tree*, not the index: cargo reads the filesystem, so the tree is
# what would actually be linted either way, and CLAUDE.md's rule is about the
# tree ("the tree must be `cargo fmt --check`-clean"). A dirty experiment left
# beside a clean staged change therefore blocks the commit -- which is the rule
# working, not the hook overreaching.
#
# `--porcelain -z`, not plain `--porcelain`: the human format quotes any path
# that is not plain ASCII (`"src/caf\303\251.rs"`), and a quoted path stops
# matching `*.rs` -- the hook would then see no Rust and wave the commit through
# without a word. The -z format never quotes. Each record is `XY <path>`, with a
# rename's original path following as a record of its own; the new path is the
# one that says which workspace was touched, so the original is read and
# dropped.

want_root=0
want_gui=0
want_fuzz=0
books=""
while IFS= read -r -d '' entry; do
    case "${entry:0:1}" in
        R | C) IFS= read -r -d '' _orig ;;
    esac
    path=${entry:3}
    # Which book reads this path? A book's sources are its own pages plus
    # whatever its API generator parses -- the Python package's docstrings for
    # pydoc-markdown, the web package's TypeScript for TypeDoc -- so a change to
    # a docstring is a change to a book. The root book has no generator: its
    # pages are all there is (rustdoc is a separate build, covered by the
    # feature-matrix skill, not by CI's `docs` job).
    case "$path" in
        clients/python/docs/* | clients/python/pydoc-markdown.yml | clients/python/clausters/*.py)
            case " $books " in *" python "*) ;; *) books="$books python" ;; esac ;;
        clients/web/docs/* | clients/web/typedoc.json | clients/web/tsconfig*.json | clients/web/src/*)
            case " $books " in *" web "*) ;; *) books="$books web" ;; esac ;;
        docs/* | book.toml)
            case " $books " in *" server "*) ;; *) books="$books server" ;; esac ;;
    esac
    case "$path" in
        *.rs | Cargo.toml | Cargo.lock | */Cargo.toml | */Cargo.lock) ;;
        *) continue ;;
    esac
    case "$path" in
        clients/gui/*) want_gui=1 ;;
        fuzz/*) want_fuzz=1 ;;
        clients/*) ;; # other clients hold no Rust the root workspace builds
        *) want_root=1 ;;
    esac
done < <(git -C "$root" status --porcelain -z --untracked-files=all 2>/dev/null)

[ "$want_root$want_gui$want_fuzz" = "000" ] && [ -z "$books" ] && exit 0

# Said now that it is known whether any Rust leg was even wanted: an inert
# toolchain is worth a warning when it stops a check, not when there was
# nothing for it to check.
if [ -n "$missing" ]; then
    if [ "$want_root$want_gui$want_fuzz" != "000" ]; then
        echo "clausters: pre-commit's Rust legs are inert -- not available:$missing." >&2
        echo "Commits touching Rust are NOT being checked for fmt/clippy warnings." >&2
        echo "The components come from rustup: rustup component add rustfmt clippy." >&2
        echo "See docs/contributing.md, \"The commit hook\"." >&2
    fi
    want_root=0
    want_gui=0
    want_fuzz=0
fi

# --- Lint them ---------------------------------------------------------------

out=$(mktemp)
trap 'rm -f "$out"' EXIT
failed=""

check() {
    local label="$1" dir="$2"
    shift 2
    if ! (cd "$dir" && "$@") >>"$out" 2>&1; then
        failed="$failed $label"
    fi
}

if [ "$want_root" = 1 ]; then
    check "fmt" "$root" cargo fmt --check
    check "clippy" "$root" cargo clippy --workspace --all-targets -- -D warnings
fi
if [ "$want_gui" = 1 ]; then
    check "fmt(gui)" "$root/clients/gui" cargo fmt --check
    check "clippy(gui)" "$root/clients/gui" cargo clippy --all-targets -- -D warnings
fi
if [ "$want_fuzz" = 1 ]; then
    check "fmt(fuzz)" "$root/fuzz" cargo fmt --check
    check "clippy(fuzz)" "$root/fuzz" cargo clippy --all-targets -- -D warnings
fi
if [ -n "$books" ]; then
    # shellcheck disable=SC2086 -- $books is a list of literal words.
    "$root/scripts/check-docs.sh" $books >>"$out" 2>&1
    status=$?
    # Exit 2 is "a generator is not installed": a check that did not run, not a
    # book that failed, so it warns and stands down -- the same fail-open rule
    # as the toolchain above. The script says which tool on its own stderr,
    # which is inside "$out" and only printed when something fails, so the note
    # is repeated here where it will actually be read.
    if [ "$status" = 2 ]; then
        echo "clausters: pre-commit's book legs are inert -- a doc generator is" >&2
        echo "missing. Run scripts/check-docs.sh to see which one." >&2
    elif [ "$status" != 0 ]; then
        failed="$failed books(${books# })"
    fi
fi

# --- Report -------------------------------------------------------------------

# The five def-family builds are not run here, and CI never runs them either, so
# a warning that appears only under `synth` alone reaches `main` with nothing
# having looked at it. Said on the way past whether or not the lint failed: a
# *clean* commit of feature-gated code is exactly the case where nothing else
# would bring the matrix up. `diff HEAD` covers staged and unstaged alike.
#
# The diff is captured before it is matched rather than piped into grep: `set -o
# pipefail` is on, `grep -q` closes the pipe at the first match, and git then
# dies of SIGPIPE -- so the pipeline reports 141 exactly when there *was* a
# match, and the note would be printed only when it is not wanted.
matrix_note() {
    local diff
    diff=$(git -C "$root" diff -U0 HEAD 2>/dev/null)
    grep -q '^+.*cfg(feature' <<<"$diff" || return 0
    {
        echo
        echo "This diff touches feature-gated code, and CI never builds the"
        echo "def-family matrix -- run .claude/skills/feature-matrix/check.sh"
        echo "(or its --fast form) before committing."
    } >&2
}

if [ -n "$failed" ]; then
    {
        echo "Commit blocked --$failed failed."
        case "$failed" in
            *fmt* | *clippy*)
                echo
                echo "CLAUDE.md: the tree must be \`cargo fmt --check\`-clean and clippy"
                echo "must come back clean, always (zero warnings, not \"no new ones\" --"
                echo "fix the ones this change did not introduce too, in their own commit"
                echo "so the feature's diff stays readable). A warning that is genuinely"
                echo "wrong gets a scoped #[allow(...)] with a comment saying why."
                ;;
        esac
        case "$failed" in
            *books*)
                echo
                echo "A book that does not build here does not build on Read the Docs"
                echo "either, and CI's \`docs\` job will say so minutes from now. Rerun"
                echo "just that leg with scripts/check-docs.sh."
                ;;
        esac
        echo
        tail -60 "$out"
        echo
        echo "To bypass: git commit --no-verify"
    } >&2
    matrix_note
    exit 1
fi

matrix_note
exit 0
